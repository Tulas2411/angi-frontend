{
  "name": "angi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node --env-file=.env.local scripts/smoke-test.mjs",
    "test:browser": "playwright test",
    "test:live": "node --env-file=.env.integration node_modules/@playwright/test/cli.js test --config=playwright.live.config.ts",
    "test:visual": "node scripts/visual-check.mjs",
    "test:states": "node scripts/state-visual-check.mjs",
    "format:check": "prettier --check src tests scripts docs playwright.config.ts"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "iron-session": "^9.0.1",
    "mapbox-gl": "^3.33.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
