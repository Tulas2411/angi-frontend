API_BASE_URL=http://127.0.0.1:5154/api/v1
NEXT_PUBLIC_API_BASE_URL=/api
APP_URL=http://localhost:3000
SESSION_PASSWORD=
# Production only (Vercel): same value as TrustedClientIp__ProxyKey on the backend, so its rate limits see each visitor's IP. Leave empty locally.
BACKEND_PROXY_KEY=
# Optional public Mapbox token (pk.*) for the restaurant location picker.
# Public pk. token for all Mapbox views; sync from backend with ./scripts/sync-mapbox-env.ps1
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Public OAuth client ID; must match Google:ClientId in BE.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_DATA_MODE=live
# /demo (sample data) is served only when this is exactly true; leave it unset in production.
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_ENABLE_COMPONENT_GALLERY=false
# Dev only: extra hosts allowed to open `next dev` from another device (comma list, e.g. my-pc.local).
# This machine's own LAN IPs are already allowed by next.config.ts.
DEV_ALLOWED_ORIGINS=
